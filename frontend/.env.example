# Baked into the bundle at BUILD time — redeploy after changing on Vercel.
# REST API base URL (no trailing slash).
# Production: leave it UNSET to use the Vercel proxy in vercel.json (same-origin cookies, works in
# Safari/Firefox). Then GOOGLE_REDIRECT_URI must be https://<your-vercel-domain>/auth/google/callback.
# Set it only if you call the Render API directly (cross-site cookies: Chrome only, see H3).
VITE_API_URL=http://localhost:3000
# WebSocket server URL — must be wss:// in production
VITE_WS_URL=ws://localhost:3001
