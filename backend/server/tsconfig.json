{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
