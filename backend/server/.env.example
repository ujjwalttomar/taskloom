# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Long random string. MUST be identical in backend/ws/.env
JWT_SECRET=change-me-to-a-long-random-string

# ── Google OAuth (Google Cloud Console → Credentials → OAuth client) ─────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an "Authorized redirect URI" in the Google console
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Exact frontend origin, no trailing slash (CORS, post-login redirect, invite links)
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Local example: postgresql://postgres:postgres@localhost:5432/taskloom
# Supabase runtime: transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Used only by the Prisma CLI (db push / migrate). Supabase: session pooler (port 5432)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Redis (pub/sub to the WebSocket server) ─────────────────────────────
# Local: redis://localhost:6379 — Upstash needs TLS: rediss://default:PASSWORD@HOST:6379
REDIS_URL=redis://localhost:6379

# ── Email (optional — invites still return a copyable link without it) ──
RESEND_API_KEY=
EMAIL_FROM=Taskloom <onboarding@resend.dev>
