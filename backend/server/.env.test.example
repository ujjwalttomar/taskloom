# Copy to .env.test (gitignored) to run `npm test`.
#
# The tests create real rows, so they need their OWN database. vitest.config.mts refuses
# to run unless this URL points at localhost and the database name ends in "_test",
# so they can never touch Supabase or your dev database.
#
# Quick local Postgres with Docker:
#   docker run -d --name taskloom-test-db -e POSTGRES_PASSWORD=postgres -p 5433:5432 postgres:17
#   docker exec taskloom-test-db psql -U postgres -c "CREATE DATABASE taskloom_test"
#
# The tables are created automatically on the first run (prisma db push). Nothing is
# ever deleted: every test creates its own uniquely named users.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/taskloom_test
