# Render injects PORT in production; 3001 is the local default
PORT=3001
# MUST be identical to JWT_SECRET in backend/server/.env
JWT_SECRET=change-me-to-a-long-random-string
# Same Redis as the REST server (Upstash needs rediss://)
REDIS_URL=redis://localhost:6379
# Same database as the REST server — used to check board membership on join
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Exact frontend origin; WebSocket upgrades from other origins are rejected
FRONTEND_URL=http://localhost:5173
